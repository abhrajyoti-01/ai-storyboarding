# --- Image generation -------------------------------------------------------
# Optional. Without a key the app uses Pollinations.ai (free, no signup).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Runtime behavior -------------------------------------------------------
# Number of panels to generate (clamped to 1-6).
STORYBOARD_PANEL_COUNT=4
# Flask debug mode. Keep false in any shared or public deployment.
FLASK_DEBUG=false

# --- Image proxy ------------------------------------------------------------
# Attempts made by /image-proxy before giving up on a Pollinations image.
IMAGE_PROXY_RETRIES=3
